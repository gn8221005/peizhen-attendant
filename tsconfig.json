{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "types": ["@dcloudio/types"]
  },
  "include": [
    "App.vue",
    "main.js",
    "vite.config.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "pages/**/*.vue"
  ]
}
